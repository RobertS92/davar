# Railway / local Express backend

PORT=3000
NODE_ENV=development

# Required in production — long random string
JWT_SECRET=change-me-to-a-long-random-secret

# OpenAI for /api/ai and /api/tts
OPENAI_API_KEY=

# Comma-separated allowed front-end origins (your Vercel URL)
# CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173

# Persist SQLite on a Railway volume, e.g. mount volume at /data
# DATABASE_PATH=/data/scripture.db
