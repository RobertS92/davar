# Copy to web/.env.local for local Vite, and set the same names in Vercel.

# --- Supabase (required for cloud playlist sync + analytics) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- OpenAI (Vercel serverless /api/ai and /api/tts — server only on Vercel) ---
OPENAI_API_KEY=sk-...

# Optional: also works locally via Vite API middleware from repo root .env
# EXPO_PUBLIC_VIBECODE_OPENAI_API_KEY=

# --- NIV (optional) ---
# VITE_BIBLE_API_KEY=
# EXPO_PUBLIC_BIBLE_API_KEY=
