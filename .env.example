# Vibecode / Expo public env
# Replace placeholder values with real keys. Values containing "n0tr3al", "your-", or "placeholder" are treated as unset.

EXPO_PUBLIC_VIBECODE_OPENAI_API_KEY=
EXPO_PUBLIC_VIBECODE_ANTHROPIC_API_KEY=
EXPO_PUBLIC_VIBECODE_GROK_API_KEY=
EXPO_PUBLIC_VIBECODE_GOOGLE_API_KEY=
EXPO_PUBLIC_VIBECODE_ELEVENLABS_API_KEY=
EXPO_PUBLIC_VIBECODE_PROJECT_ID=

# Optional: hosted Davar backend base URL (no trailing slash)
# Example: https://api.yourdomain.com
EXPO_PUBLIC_API_URL=

# Optional: api.bible key enables NIV translation
EXPO_PUBLIC_BIBLE_API_KEY=
